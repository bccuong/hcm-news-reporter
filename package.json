{
  "name": "news-reporter",
  "version": "0.1.0",
  "private": true,
  "description": "News Reporter - ứng dụng local-first tổng hợp điểm tin báo chí theo địa bàn (mặc định: ngành xây dựng TP.HCM)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "start": "npm run build:web && tsx src/server/index.ts",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "build:pages": "tsx scripts/build-demo-data.ts && vite build --mode pages",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "test:ui:live": "playwright test -c playwright.live.config.ts",
    "spike": "tsx scripts/spike-live.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.0",
    "fastify": "^5.1.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pptxgenjs": "^3.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "yaml": "^2.6.1"
  }
}
